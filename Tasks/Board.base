filters:
  and:
    - file.inFolder("Tasks/Queue")
properties:
  file.name:
    displayName: Task
  note.project:
    displayName: Project
  note.assignee:
    displayName: Owner
  note.depends_on:
    displayName: Waits on
  note.done_test:
    displayName: Done when
views:
  - type: table
    name: Board (by status)
    groupBy:
      property: note.status
      direction: ASC
    order:
      - file.name
      - project
      - assignee
      - priority
      - depends_on
      - claimed_by
      - done_test
    sort:
      - property: note.project
        direction: ASC
      - property: note.priority
        direction: ASC
  - type: table
    name: By project
    groupBy:
      property: note.project
      direction: ASC
    order:
      - file.name
      - status
      - assignee
      - priority
      - depends_on
    sort:
      - property: note.status
        direction: ASC
  - type: table
    name: Human tasks (owner)
    filters:
      and:
        - assignee == "mika"
        - status != "done"
    order:
      - file.name
      - project
      - priority
      - depends_on
      - done_test
    sort:
      - property: note.priority
        direction: ASC
  - type: table
    name: Agent queue (ready)
    filters:
      and:
        - assignee != "mika"
        - status == "queued"
    order:
      - file.name
      - project
      - assignee
      - priority
      - depends_on
      - touches
    sort:
      - property: note.priority
        direction: ASC
